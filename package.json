{
  "description": "A pi extension that uses TypeSafe AI's Jev model to curate context before each LLM call, keeping only the context the next call is likely to need.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "jev"
  ],
  "license": "MIT",
  "name": "pi-jev-context-curator",
  "files": [
    "LICENSE",
    "README.md",
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shashank-H/pi-jev-context-curator"
  },
  "bugs": {
    "url": "https://github.com/Shashank-H/pi-jev-context-curator/issues"
  },
  "homepage": "https://github.com/Shashank-H/pi-jev-context-curator#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "type": "module",
  "version": "1.1.1-beta.2",
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
